#!/bin/bash
# description: Start or stop the Wolf ISM8i server
# script by Dr. Mugur Dietrich

### BEGIN INIT INFO
# Provides:             wolf_ism8i.pl
# Required-Start:
# Required-Stop:
# Default-Start:        2 3 4 5
# Default-Stop:         0 1 6
# Short-Description:    Wolf ISM8i server
### END INIT INFO


. $LBHOMEDIR/libs/bashlib/loxberry_log.sh

# Der eigene Ablageort, nicht ${LBPBIN}/<fester Name>.
#
# Gemessen am 04.09.2026 mit einer Attrappe des Watchdogs:
#   LBPBIN gesetzt, Skript unter wolf_ng     -> startet wolf_ng     RC=0
#   LBPBIN NICHT gesetzt                     -> startet NICHTS      RC=0
#   Skript unter wolf_ng_01, LBPBIN gesetzt  -> startet wolf_ng     RC=0
#
# Der zweite Fall ist der gefaehrliche: start meldete Erfolg, ohne
# etwas zu starten, und stop beendete nichts und meldete ebenfalls
# Erfolg, weil die Wirkungsmessung mit demselben falschen Pfad sucht.
# Der dritte ist der Zweitinstallations-Fall, vor dem die plugin.cfg
# selbst warnt: LoxBerry haengt bei einer Namenskollision _01 an.
BINPATH=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
if [ -z "$BINPATH" ] || [ ! -f "$BINPATH/wolf_watchdog.sh" ]; then
    echo "Wolf ISM8i: eigener Ablageort nicht bestimmbar - Abbruch." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Laeuft gerade eine Aktualisierung dieses Plugins?
#
# preupgrade.sh legt die Marke als Erstes NEBEN den Datenordner
# (<wurzel>/data/plugins/<ordner>.upgrade_laeuft); im Datenordner selbst
# loeschte purge_installation sie mit. postupgrade.sh entfernt sie NACH dem
# Dienststart.
#
# Warum es das gibt, in WSL gemessen am 18.09.2026
# (Pruefung-WOLF-ISM-NG-3.1.3/messung_vorher.txt, Fall C8): ohne diese Sperre
# standen nach einer Aktualisierung ZWEI Watchdogs da. Der Waechter aus
# cron/cron.05min faellt in das Fenster zwischen dem Beenden und dem Neustart,
# den postupgrade.sh macht, findet nichts laufen und startet einen eigenen.
#
# Nur eine Marke, die hoechstens eine Stunde alt ist, zaehlt. Aelter oder
# unlesbar hat eine abgebrochene Installation sie liegen lassen - dann gilt
# sie nicht, sonst stuende das Plugin fuer immer still.
#
# WI_START_TROTZ_MARKE=1 setzt nur postupgrade.sh: dort ist die Marke die
# eigene, und der Start ist der letzte Schritt der Installation.
# ---------------------------------------------------------------------------
LBWURZEL=$(cd "$BINPATH/../../.." 2>/dev/null && pwd)
MARKE=""
if [ -n "$LBWURZEL" ]; then
    MARKE="$LBWURZEL/data/plugins/$(basename "$BINPATH").upgrade_laeuft"
fi

upgrade_laeuft() {
    [ "${WI_START_TROTZ_MARKE:-0}" = "1" ] && return 1
    [ -n "$MARKE" ] || return 1
    [ -f "$MARKE" ] || return 1
    SEIT=$(cat "$MARKE" 2>/dev/null)
    case "$SEIT" in
        ''|*[!0-9]*) return 1 ;;
    esac
    # Die Uhr wird gemessen, nicht angenommen: liefert "date" nichts - unter
    # Last kann ein fork scheitern -, rechnete die Schale mit einer leeren
    # Zeichenkette, das Alter wuerde negativ, die Bedingung fiele durch und
    # der Dienst startete mitten in der Aktualisierung. Ein Schutz faellt
    # geschlossen aus (Regeln/01): ohne Uhr gilt die Marke.
    JETZT=$(date +%s 2>/dev/null)
    case "$JETZT" in
        ''|*[!0-9]*) return 0 ;;
    esac
    ALTER=$(( JETZT - SEIT ))
    [ "$ALTER" -ge 0 ] && [ "$ALTER" -lt 3600 ]
}

# ---------------------------------------------------------------------------
# Prozesssuche - bitte nicht auf pkill zurueckbauen
#
# "pkill -f wolf_ism8i.pl" durchsucht die GANZE Befehlszeile jedes Prozesses
# und trifft damit auch einen Editor mit offener Datei oder ein zweites
# Exemplar des Plugins. "ps -C" und "killall" vergleichen den comm-Namen, der
# bei einem Skript mit Shebang "bash" bzw. "perl" lautet - die finden nichts.
#
# Ein Treffer liegt vor, wenn das erste Argument der volle Skriptpfad ist
# (Shebang-Start) oder wenn das erste Argument ein Interpreter ist UND der
# volle Pfad unter den Argumenten steht (der Watchdog startet das
# Auswertungsmodul als "perl -X <pfad>").
# ---------------------------------------------------------------------------
wolf_beenden() {
    SKRIPT="$1"
    for D in /proc/[0-9]*; do
        P=$(basename "$D")
        [ -r "$D/cmdline" ] || continue
        ARGS=$(tr '\0' '\n' < "$D/cmdline" 2>/dev/null)
        ERSTES=$(printf '%s\n' "$ARGS" | head -1)
        if [ "$ERSTES" = "$SKRIPT" ] ||
           { case "$(basename "$ERSTES")" in perl|bash|sh|dash) true ;; *) false ;; esac &&
             printf '%s\n' "$ARGS" | grep -qxF "$SKRIPT"; }; then
            kill "$P" 2>/dev/null
        fi
    done
}

# Laeuft ein Prozess zu diesem Skriptpfad? Gleiche Erkennung wie
# wolf_beenden, nur ohne zu toeten.
wolf_laeuft() {
    SKRIPT="$1"
    for D in /proc/[0-9]*; do
        [ -r "$D/cmdline" ] || continue
        ARGS=$(tr '\0' '\n' < "$D/cmdline" 2>/dev/null)
        ERSTES=$(printf '%s\n' "$ARGS" | head -1)
        if [ "$ERSTES" = "$SKRIPT" ] ||
           { case "$(basename "$ERSTES")" in perl|bash|sh|dash) true ;; *) false ;; esac &&
             printf '%s\n' "$ARGS" | grep -qxF "$SKRIPT"; }; then
            return 0
        fi
    done
    return 1
}

# Carry out specific functions when asked to by the system
case "$1" in
  'start')
    # ERST fragen, DANN starten. Bis 3.1.3 stand der Start in der ersten
    # Zeile und wolf_laeuft darunter - als Wirkungsmessung, nicht als
    # Bedingung. Ein zweiter Aufruf legte deshalb einen zweiten Watchdog an
    # (in WSL gemessen 18.09.2026, Fall A1b: 2 Prozesse statt 1), und jeder
    # davon startet ein eigenes Auswertungsmodul auf demselben ISM8-Port.
    # "start" rufen daemon/daemon beim Systemstart und cron/cron.05min; der
    # Waechter fragt vorher selbst nach, der Systemstart nicht.
    if upgrade_laeuft; then
        echo "Wolf ISM8i: eine Aktualisierung dieses Plugins laeuft - nicht gestartet."
        RETVAL=0
    elif wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
        echo "Wolf ISM8i server laeuft bereits - kein zweiter Start."
        RETVAL=0
    else
        echo "Starting Wolf ISM8i server"
        ${BINPATH}/wolf_watchdog.sh &
        # RETVAL=$? unmittelbar nach "&" misst den Hintergrundstart, nicht
        # den Lauf: "false &" ergibt 0, "/gibtesnicht &" ebenso. Der
        # stop-Zweig wurde deshalb schon in 3.0.8 auf Wirkungsmessung
        # umgebaut - start und restart blieben stehen. Jetzt nicht mehr.
        sleep 1
        if wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
            RETVAL=0
        else
            echo "WARNUNG: der Watchdog laeuft nach dem Start nicht."
            RETVAL=1
        fi
    fi
    ;;
  'stop')
    # "stop" fragt NICHT nach der Marke. Ein Anhalten kann keinen zweiten
    # Dienst erzeugen, und postupgrade.sh braucht den Weg: sein "restart"
    # beendet zuerst. Gegenprobe im Pruefstand: Fall C7s, Rueckgabewert 0
    # bei liegender Marke.
    echo "Stopping Wolf ISM8i server"
    wolf_beenden "${BINPATH}/wolf_watchdog.sh"
    wolf_beenden "${BINPATH}/wolf_ism8i.pl"
    # RETVAL=$? nach wolf_beenden trug keine Aussage - die Funktion endet
    # immer erfolgreich, stop meldete also IMMER Erfolg. Gemessen wird
    # jetzt die WIRKUNG.
    sleep 1
    if wolf_laeuft "${BINPATH}/wolf_watchdog.sh" || wolf_laeuft "${BINPATH}/wolf_ism8i.pl"; then
        echo "WARNUNG: es laeuft noch ein Prozess."
        RETVAL=1
    else
        RETVAL=0
    fi
    ;;
  'restart')
    # Auch der Neustart achtet die Marke: der Knopf "Dienst neu starten" im
    # Reiter Test kommt hier an, und in der Aktualisierungsluecke liefe der
    # Dienst mit der mitgelieferten Vorgabe-Konfiguration - anderer
    # ISM8-Port, anderes Themenpraefix (Fall B3). postupgrade.sh setzt
    # WI_START_TROTZ_MARKE=1 und kommt damit durch.
    if upgrade_laeuft; then
        echo "Wolf ISM8i: eine Aktualisierung dieses Plugins laeuft - nicht neu gestartet."
        RETVAL=0
    else
        echo "Restarting Wolf ISM8i server"
        wolf_beenden "${BINPATH}/wolf_watchdog.sh"
        wolf_beenden "${BINPATH}/wolf_ism8i.pl"
        # Hier stand ein RETVAL=$? nach wolf_beenden - eine tote
        # Zuweisung, drei Zeilen spaeter ueberschrieben.
        sleep 1
        ${BINPATH}/wolf_watchdog.sh &
        sleep 1
        if wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
            RETVAL=0
        else
            echo "WARNUNG: der Watchdog laeuft nach dem Neustart nicht."
            RETVAL=1
        fi
    fi
    ;;
  'status')
    # status hat bis 3.0.7 nur den Watchdog angesehen. Der kann laufen,
    # waehrend das Auswertungsmodul in seiner Neustartschleife haengt -
    # die Meldung "is running" war dann eine halbe Wahrheit.
    W=0; M=0
    wolf_laeuft "${BINPATH}/wolf_watchdog.sh" && W=1
    wolf_laeuft "${BINPATH}/wolf_ism8i.pl"    && M=1
    if [ "$W" -eq 1 ] && [ "$M" -eq 1 ]; then
        echo "Wolf ISM8i server is running (Watchdog und Auswertungsmodul)"
        RETVAL=0
    elif [ "$W" -eq 1 ]; then
        echo "Wolf ISM8i server: Watchdog laeuft, Auswertungsmodul NICHT"
        RETVAL=1
    elif [ "$M" -eq 1 ]; then
        echo "Wolf ISM8i server: Auswertungsmodul laeuft ohne Watchdog"
        RETVAL=1
    else
        echo "Wolf ISM8i server is not running"
        RETVAL=3
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/wolfserver {start|stop|restart|status}"
    exit 1
    ;;
esac

exit $RETVAL
