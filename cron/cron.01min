#!/bin/sh
#
# WOLF ISM NG - Waechter der Befehlsbruecke, minuetlich.
#
# Gruppe 5 / MQTT (3.1.12, Entwurf wo E15; Muster vb_g3_fb_bau/cron/cron.01min): die Linie hat keinen PHP-Minutentakt
# (nur cron.05min mit wolf_sg.php und wolf_ansage.php; der Perl-Dienst hat einen eigenen Waechter). cron.05min endet
# bei der Marke einer Aktualisierung und bei ausgeschaltetem Server vorzeitig und liefe fuenfmal seltener - diese
# Datei hat deshalb nur eine Befehlszeile und steht vor keiner Sperre. Der Waechter der gemeinsamen Stammfassung
# startet die Bruecke nur mit dem Haken "Befehle ueber MQTT annehmen" (ab Werk aus) bei eingeschaltetem Server,
# haelt sie sonst an, sendet <praefix>/status/befehle (nie retained) und liest die Marke einer Aktualisierung selbst
# (data/plugins/<ordner>.upgrade_laeuft - dieselbe wie in cron.05min und preupgrade.sh). Aufruf ueber bash (das
# Skript ist bash, nicht sh); stdout weg, die Fehlerausgabe nach cron.err.
#
# Die Platzhalter fuer bin- und Log-Ordner setzt der Installer ein; sie stehen deshalb NUR in den Befehlszeilen und
# nicht in diesem Kommentar.
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
touch "REPLACELBPLOGDIR/cron.err" 2>/dev/null
bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null 2>>"REPLACELBPLOGDIR/cron.err"
