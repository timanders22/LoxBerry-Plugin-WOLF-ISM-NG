#!/bin/bash
# description: Start or stop the Wolf ISM8i server
# script by Dr. Mugur Dietrich

### BEGIN INIT INFO
# Provides:             wolf_ism8i.pl
# Required-Start:
# Required-Stop:
# Default-Start:        2 3 4 5
# Default-Stop:         0 1 6
# Short-Description:    Wolf ISM8i server
### END INIT INFO


# Der eigene Ablageort, nicht ${LBPBIN}/<fester Name>.
#
# Gemessen am 04.09.2026 mit einer Attrappe des Watchdogs:
#   LBPBIN gesetzt, Skript unter wolf_ng     -> startet wolf_ng     RC=0
#   LBPBIN NICHT gesetzt                     -> startet NICHTS      RC=0
#   Skript unter wolf_ng_01, LBPBIN gesetzt  -> startet wolf_ng     RC=0
#
# Der zweite Fall ist der gefaehrliche: start meldete Erfolg, ohne
# etwas zu starten, und stop beendete nichts und meldete ebenfalls
# Erfolg, weil die Wirkungsmessung mit demselben falschen Pfad sucht.
# Der dritte ist der Zweitinstallations-Fall, vor dem die plugin.cfg
# selbst warnt: LoxBerry haengt bei einer Namenskollision _01 an.
SELF=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd -P)
if [ -z "$SELF" ] || [ ! -f "$SELF/wolf_watchdog.sh" ]; then
    echo "Wolf ISM8i: eigener Ablageort nicht bestimmbar - Abbruch." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Wurzel und Ordner: GELESEN oder gesucht, danach nichts mehr (Regeln/06,
# Muster 1 und 3 der Nachlese; Bauart dienst.sh Spotpreis-Tibber 0.9.19).
#
# Bis 3.1.4 stand hier "$BINPATH/../../.." ohne jede Pruefung, und
# ". $LBHOMEDIR/libs/bashlib/loxberry_log.sh" las bei leerem LBHOMEDIR ab
# der Laufwerkswurzel. In WSL gemessen (Pruefung-WOLF-ISM-NG-3.1.4): in einem
# fremden Baum ohne general.json startete "start" einen Watchdog (Fall W1),
# und aus einem ausgepackten Archiv unter der echten Wurzel ebenso (W2).
#   1. $LBHOMEDIR, wenn es config/plugins und data/plugins traegt;
#   2. aufwaerts suchen, bis config/plugins, data/plugins UND
#      config/system/general.json da sind.
# Die Anlage gilt nur, wenn dieses Skript in ihrem bin-Ordner liegt oder der
# Aufrufer LBHOMEDIR UND LBPPLUGINDIR nennt.
# ---------------------------------------------------------------------------
wi_wurzel_suchen() {
    local v="$SELF" i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ "$i" -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"
            return 0
        fi
        v=$(dirname "$v")
        i=$((i + 1))
    done
    return 1
}
if [ -n "${LBHOMEDIR:-}" ] && [ -d "$LBHOMEDIR/config/plugins" ] \
   && [ -d "$LBHOMEDIR/data/plugins" ]; then
    WURZEL=$(cd "$LBHOMEDIR" && pwd -P)
else
    WURZEL=$(wi_wurzel_suchen) || WURZEL=""
fi
if [ -z "$WURZEL" ]; then
    echo "Wolf ISM8i: es wurde kein LoxBerry-Wurzelverzeichnis gefunden (LBHOMEDIR"
    echo "ist nicht gesetzt, und oberhalb von $SELF traegt kein Verzeichnis"
    echo "config/plugins, data/plugins und config/system/general.json)."
    echo "Es wurde nichts gestartet und nichts angehalten."
    [ "${1:-}" = "status" ] && exit 4
    exit 1
fi
PNAME="${LBPPLUGINDIR:-}"
PNAME="${PNAME%/}"
PNAME="${PNAME##*/}"
[ -n "$PNAME" ] || PNAME=$(basename "$SELF")
WI_AUSDRUECKLICH=0
if [ -n "${LBPPLUGINDIR:-}" ] && [ -n "${LBHOMEDIR:-}" ] \
   && [ "$WURZEL" = "$(cd "$LBHOMEDIR" 2>/dev/null && pwd -P)" ] \
   && [ -d "$WURZEL/config/plugins/$PNAME" ]; then
    WI_AUSDRUECKLICH=1
fi
if [ "$SELF" != "$(readlink -f "$WURZEL/bin/plugins/$PNAME" 2>/dev/null)" ] \
   && [ "$WI_AUSDRUECKLICH" != "1" ]; then
    echo "Wolf ISM8i: $SELF ist nicht der bin-Ordner von '$PNAME' unter $WURZEL,"
    echo "und LBHOMEDIR und LBPPLUGINDIR nennen die Anlage nicht beide. Der Aufruf"
    echo "kommt offenbar aus einem ausgepackten Archiv oder einem Pruefordner."
    echo "Es wurde nichts gestartet und nichts angehalten."
    [ "${1:-}" = "status" ] && exit 4
    exit 1
fi
# Die Pfade DER ANLAGE. Installiert ist das derselbe Ordner wie SELF.
BINPATH="$WURZEL/bin/plugins/$PNAME"
# Der Watchdog liest daraus seine Protokollbibliothek.
export LBHOMEDIR="$WURZEL"

# ---------------------------------------------------------------------------
# Laeuft gerade eine Aktualisierung dieses Plugins?
#
# preupgrade.sh legt die Marke als Erstes NEBEN den Datenordner
# (<wurzel>/data/plugins/<ordner>.upgrade_laeuft); im Datenordner selbst
# loeschte purge_installation sie mit. postupgrade.sh entfernt sie NACH dem
# Dienststart.
#
# Warum es das gibt, in WSL gemessen am 18.09.2026
# (Pruefung-WOLF-ISM-NG-3.1.3/messung_vorher.txt, Fall C8): ohne diese Sperre
# standen nach einer Aktualisierung ZWEI Watchdogs da. Der Waechter aus
# cron/cron.05min faellt in das Fenster zwischen dem Beenden und dem Neustart,
# den postupgrade.sh macht, findet nichts laufen und startet einen eigenen.
#
# Nur eine Marke, die hoechstens eine Stunde alt ist, zaehlt. Aelter oder
# unlesbar hat eine abgebrochene Installation sie liegen lassen - dann gilt
# sie nicht, sonst stuende das Plugin fuer immer still.
#
# WI_START_TROTZ_MARKE=1 setzt nur postupgrade.sh: dort ist die Marke die
# eigene, und der Start ist der letzte Schritt der Installation.
# ---------------------------------------------------------------------------
MARKE="$WURZEL/data/plugins/$PNAME.upgrade_laeuft"

upgrade_laeuft() {
    [ "${WI_START_TROTZ_MARKE:-0}" = "1" ] && return 1
    [ -n "$MARKE" ] || return 1
    [ -f "$MARKE" ] || return 1
    SEIT=$(cat "$MARKE" 2>/dev/null)
    case "$SEIT" in
        ''|*[!0-9]*) return 1 ;;
    esac
    # Die Uhr wird gemessen, nicht angenommen: liefert "date" nichts - unter
    # Last kann ein fork scheitern -, rechnete die Schale mit einer leeren
    # Zeichenkette, das Alter wuerde negativ, die Bedingung fiele durch und
    # der Dienst startete mitten in der Aktualisierung. Ein Schutz faellt
    # geschlossen aus (Regeln/01): ohne Uhr gilt die Marke.
    JETZT=$(date +%s 2>/dev/null)
    case "$JETZT" in
        ''|*[!0-9]*) return 0 ;;
    esac
    ALTER=$(( JETZT - SEIT ))
    # Bis 300 s "Zukunft" gilt sie noch: die Uhr kann nach dem Setzen ein
    # Stueck zurueckspringen (Muster 8 der Nachlese, Govee 0.9.20). Bis 3.1.4
    # stand hier -ge 0, und eine 200 s vorauseilende Marke sperrte nichts
    # (Fall W7).
    [ "$ALTER" -ge -300 ] && [ "$ALTER" -lt 3600 ]
}

# ---------------------------------------------------------------------------
# Prozesssuche ARGUMENTWEISE ueber /proc/<pid>/cmdline - nie pkill -f
#
# Ein Treffer hat genau eine dieser Formen, und der Prozess gehoert dem
# Dienstbenutzer (loxberry, wo es ihn nicht gibt der eigene):
#   <bash|sh|dash|perl> <skript>      Start ueber den Shebang
#   perl -X <skript>                  so startet der Watchdog das Modul
# <skript> ist zeichengenau der erwartete Pfad (relativ gestartet gegen
# /proc/<pid>/cwd aufgeloest, zusaetzlich ueber readlink -f verglichen). Ein
# weiteres Argument ist ein Einmallauf, kein Dienst.
#
# Bis 3.1.4 genuegte "Interpreter vorn und der Pfad IRGENDWO unter den
# Argumenten" (grep -qxF): ein "perl -e '...' <modulpfad>" galt als Dienst
# und wurde beendet (Faelle W4, W5, W15, Pruefung-WOLF-ISM-NG-3.1.4), und vor
# kill -9 wurde nicht noch einmal geprueft. Bauart tb_ist_dienst()
# (Spotpreis-Tibber 0.9.19); dieselbe Regel steht in wi_ist_prozess()
# (webfrontend/htmlauth/wi_lib.php).
# ---------------------------------------------------------------------------
WI_DIENST_UID=$(id -u loxberry 2>/dev/null || id -u)
wi_ist_dienst() {   # $1 PID  $2 erwarteter Skriptpfad
    local a0 a1 a2 a3 pfad wd
    [ -r "/proc/$1/cmdline" ] || return 1
    [ "$(stat -c %u "/proc/$1" 2>/dev/null)" = "$WI_DIENST_UID" ] || return 1
    a0=""; a1=""; a2=""; a3=""
    { IFS= read -r -d "" a0; IFS= read -r -d "" a1; IFS= read -r -d "" a2
      IFS= read -r -d "" a3; } 2>/dev/null < "/proc/$1/cmdline"
    pfad=""
    case "${a0##*/}" in
        bash|sh|dash|perl)
            if [ -n "$a1" ] && [ -z "$a2" ]; then
                pfad="$a1"
            elif [ "${a0##*/}" = "perl" ] && [ "$a1" = "-X" ] && [ -n "$a2" ] && [ -z "$a3" ]; then
                pfad="$a2"
            fi ;;
    esac
    [ -n "$pfad" ] || return 1
    case "$pfad" in
        /*) ;;
        *)  wd=$(readlink "/proc/$1/cwd" 2>/dev/null) || return 1
            pfad="${wd% (deleted)}/$pfad" ;;
    esac
    [ "$pfad" = "$2" ] && return 0
    [ -n "$(readlink -f "$2" 2>/dev/null)" ] || return 1
    [ "$(readlink -f "$pfad" 2>/dev/null)" = "$(readlink -f "$2" 2>/dev/null)" ]
}

wi_dienste() {   # PIDs zu einem oder mehreren Skriptpfaden
    local d p s
    for d in /proc/[0-9]*; do
        p="${d#/proc/}"
        for s in "$@"; do
            if wi_ist_dienst "$p" "$s"; then echo "$p"; break; fi
        done
    done
}

wolf_laeuft() {   # laeuft ein Prozess zu diesem Skriptpfad?
    local d
    for d in /proc/[0-9]*; do
        wi_ist_dienst "${d#/proc/}" "$1" && return 0
    done
    return 1
}

# Alle Treffer der uebergebenen Pfade gemeinsam beenden: erst SIGTERM an
# alle - dann endet der Watchdog nach seinem Modul von selbst (on_die) -,
# bis zu fuenf Sekunden warten, und vor kill -9 jeden Treffer noch einmal
# argumentweise pruefen (eine freigewordene Nummer kann inzwischen einem
# fremden Prozess gehoeren).
wolf_beenden() {
    local pids p i offen s
    pids=$(wi_dienste "$@")
    [ -n "$pids" ] || return 0
    for p in $pids; do kill "$p" 2>/dev/null; done
    for i in 1 2 3 4 5; do
        offen=0
        for p in $pids; do
            for s in "$@"; do
                wi_ist_dienst "$p" "$s" && offen=1
            done
        done
        [ "$offen" -eq 0 ] && break
        sleep 1
    done
    for p in $pids; do
        for s in "$@"; do
            if wi_ist_dienst "$p" "$s"; then kill -9 "$p" 2>/dev/null; break; fi
        done
    done
    return 0
}
# Carry out specific functions when asked to by the system
case "$1" in
  'start')
    # ERST fragen, DANN starten. Bis 3.1.3 stand der Start in der ersten
    # Zeile und wolf_laeuft darunter - als Wirkungsmessung, nicht als
    # Bedingung. Ein zweiter Aufruf legte deshalb einen zweiten Watchdog an
    # (in WSL gemessen 18.09.2026, Fall A1b: 2 Prozesse statt 1), und jeder
    # davon startet ein eigenes Auswertungsmodul auf demselben ISM8-Port.
    # "start" rufen daemon/daemon beim Systemstart und cron/cron.05min; der
    # Waechter fragt vorher selbst nach, der Systemstart nicht.
    if upgrade_laeuft; then
        echo "Wolf ISM8i: eine Aktualisierung dieses Plugins laeuft - nicht gestartet."
        RETVAL=0
    elif wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
        echo "Wolf ISM8i server laeuft bereits - kein zweiter Start."
        RETVAL=0
    else
        echo "Starting Wolf ISM8i server"
        ${BINPATH}/wolf_watchdog.sh &
        # RETVAL=$? unmittelbar nach "&" misst den Hintergrundstart, nicht
        # den Lauf: "false &" ergibt 0, "/gibtesnicht &" ebenso. Der
        # stop-Zweig wurde deshalb schon in 3.0.8 auf Wirkungsmessung
        # umgebaut - start und restart blieben stehen. Jetzt nicht mehr.
        sleep 1
        if wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
            RETVAL=0
        else
            echo "WARNUNG: der Watchdog laeuft nach dem Start nicht."
            RETVAL=1
        fi
    fi
    ;;
  'stop')
    # "stop" fragt NICHT nach der Marke. Ein Anhalten kann keinen zweiten
    # Dienst erzeugen, und postupgrade.sh braucht den Weg: sein "restart"
    # beendet zuerst. Gegenprobe im Pruefstand: Fall C7s, Rueckgabewert 0
    # bei liegender Marke.
    echo "Stopping Wolf ISM8i server"
    wolf_beenden "${BINPATH}/wolf_watchdog.sh" "${BINPATH}/wolf_ism8i.pl"
    # RETVAL=$? nach wolf_beenden trug keine Aussage - die Funktion endet
    # immer erfolgreich, stop meldete also IMMER Erfolg. Gemessen wird
    # jetzt die WIRKUNG.
    sleep 1
    if wolf_laeuft "${BINPATH}/wolf_watchdog.sh" || wolf_laeuft "${BINPATH}/wolf_ism8i.pl"; then
        echo "WARNUNG: es laeuft noch ein Prozess."
        RETVAL=1
    else
        RETVAL=0
    fi
    ;;
  'restart')
    # Auch der Neustart achtet die Marke: der Knopf "Dienst neu starten" im
    # Reiter Test kommt hier an, und in der Aktualisierungsluecke liefe der
    # Dienst mit der mitgelieferten Vorgabe-Konfiguration - anderer
    # ISM8-Port, anderes Themenpraefix (Fall B3). postupgrade.sh setzt
    # WI_START_TROTZ_MARKE=1 und kommt damit durch.
    if upgrade_laeuft; then
        echo "Wolf ISM8i: eine Aktualisierung dieses Plugins laeuft - nicht neu gestartet."
        RETVAL=0
    else
        echo "Restarting Wolf ISM8i server"
        wolf_beenden "${BINPATH}/wolf_watchdog.sh" "${BINPATH}/wolf_ism8i.pl"
        # Hier stand ein RETVAL=$? nach wolf_beenden - eine tote
        # Zuweisung, drei Zeilen spaeter ueberschrieben.
        sleep 1
        ${BINPATH}/wolf_watchdog.sh &
        sleep 1
        if wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
            RETVAL=0
        else
            echo "WARNUNG: der Watchdog laeuft nach dem Neustart nicht."
            RETVAL=1
        fi
    fi
    ;;
  'status')
    # status hat bis 3.0.7 nur den Watchdog angesehen. Der kann laufen,
    # waehrend das Auswertungsmodul in seiner Neustartschleife haengt -
    # die Meldung "is running" war dann eine halbe Wahrheit.
    W=0; M=0
    wolf_laeuft "${BINPATH}/wolf_watchdog.sh" && W=1
    wolf_laeuft "${BINPATH}/wolf_ism8i.pl"    && M=1
    if [ "$W" -eq 1 ] && [ "$M" -eq 1 ]; then
        echo "Wolf ISM8i server is running (Watchdog und Auswertungsmodul)"
        RETVAL=0
    elif [ "$W" -eq 1 ]; then
        echo "Wolf ISM8i server: Watchdog laeuft, Auswertungsmodul NICHT"
        RETVAL=1
    elif [ "$M" -eq 1 ]; then
        echo "Wolf ISM8i server: Auswertungsmodul laeuft ohne Watchdog"
        RETVAL=1
    else
        echo "Wolf ISM8i server is not running"
        RETVAL=3
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/wolfserver {start|stop|restart|status}"
    exit 1
    ;;
esac

exit $RETVAL
