#!/bin/sh
#
# WOLF ISM NG - Waechter der Befehlsbruecke, minuetlich.
#
# Gruppe 5 / MQTT (3.1.12, Entwurf wo E15; Muster vb_g3_fb_bau/cron/cron.01min): die Linie hat keinen PHP-Minutentakt
# (nur cron.05min mit wolf_sg.php und wolf_ansage.php; der Perl-Dienst hat einen eigenen Waechter). cron.05min endet
# bei der Marke einer Aktualisierung und bei ausgeschaltetem Server vorzeitig und liefe fuenfmal seltener - diese
# Datei hat deshalb nur eine Befehlszeile und steht vor keiner Sperre. Der Waechter der gemeinsamen Stammfassung
# startet die Bruecke nur mit dem Haken "Befehle ueber MQTT annehmen" (ab Werk aus) bei eingeschaltetem Server,
# haelt sie sonst an, sendet <praefix>/status/befehle (nie retained) und liest die Marke einer Aktualisierung selbst
# (data/plugins/<ordner>.upgrade_laeuft - dieselbe wie in cron.05min und preupgrade.sh). Aufruf ueber bash (das
# Skript ist bash, nicht sh); stdout weg, die Fehlerausgabe nach cron.err.
#
# Die Platzhalter fuer bin- und Log-Ordner setzt der Installer ein; sie stehen deshalb NUR in den Befehlszeilen und
# nicht in diesem Kommentar.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 3.1.14 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 3.1.13 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null 2>>"$ERR"
