#!/bin/bash
# description: Start or stop the Wolf ISM8i server
# script by Dr. Mugur Dietrich

### BEGIN INIT INFO
# Provides:             wolf_ism8i.pl
# Required-Start:
# Required-Stop:
# Default-Start:        2 3 4 5
# Default-Stop:         0 1 6
# Short-Description:    Wolf ISM8i server
### END INIT INFO


. $LBHOMEDIR/libs/bashlib/loxberry_log.sh

# Der eigene Ablageort, nicht ${LBPBIN}/<fester Name>.
#
# Gemessen am 04.09.2026 mit einer Attrappe des Watchdogs:
#   LBPBIN gesetzt, Skript unter wolf_ng     -> startet wolf_ng     RC=0
#   LBPBIN NICHT gesetzt                     -> startet NICHTS      RC=0
#   Skript unter wolf_ng_01, LBPBIN gesetzt  -> startet wolf_ng     RC=0
#
# Der zweite Fall ist der gefaehrliche: start meldete Erfolg, ohne
# etwas zu starten, und stop beendete nichts und meldete ebenfalls
# Erfolg, weil die Wirkungsmessung mit demselben falschen Pfad sucht.
# Der dritte ist der Zweitinstallations-Fall, vor dem die plugin.cfg
# selbst warnt: LoxBerry haengt bei einer Namenskollision _01 an.
BINPATH=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
if [ -z "$BINPATH" ] || [ ! -f "$BINPATH/wolf_watchdog.sh" ]; then
    echo "Wolf ISM8i: eigener Ablageort nicht bestimmbar - Abbruch." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Prozesssuche - bitte nicht auf pkill zurueckbauen
#
# "pkill -f wolf_ism8i.pl" durchsucht die GANZE Befehlszeile jedes Prozesses
# und trifft damit auch einen Editor mit offener Datei oder ein zweites
# Exemplar des Plugins. "ps -C" und "killall" vergleichen den comm-Namen, der
# bei einem Skript mit Shebang "bash" bzw. "perl" lautet - die finden nichts.
#
# Ein Treffer liegt vor, wenn das erste Argument der volle Skriptpfad ist
# (Shebang-Start) oder wenn das erste Argument ein Interpreter ist UND der
# volle Pfad unter den Argumenten steht (der Watchdog startet das
# Auswertungsmodul als "perl -X <pfad>").
# ---------------------------------------------------------------------------
wolf_beenden() {
    SKRIPT="$1"
    for D in /proc/[0-9]*; do
        P=$(basename "$D")
        [ -r "$D/cmdline" ] || continue
        ARGS=$(tr '\0' '\n' < "$D/cmdline" 2>/dev/null)
        ERSTES=$(printf '%s\n' "$ARGS" | head -1)
        if [ "$ERSTES" = "$SKRIPT" ] ||
           { case "$(basename "$ERSTES")" in perl|bash|sh|dash) true ;; *) false ;; esac &&
             printf '%s\n' "$ARGS" | grep -qxF "$SKRIPT"; }; then
            kill "$P" 2>/dev/null
        fi
    done
}

# Laeuft ein Prozess zu diesem Skriptpfad? Gleiche Erkennung wie
# wolf_beenden, nur ohne zu toeten.
wolf_laeuft() {
    SKRIPT="$1"
    for D in /proc/[0-9]*; do
        [ -r "$D/cmdline" ] || continue
        ARGS=$(tr '\0' '\n' < "$D/cmdline" 2>/dev/null)
        ERSTES=$(printf '%s\n' "$ARGS" | head -1)
        if [ "$ERSTES" = "$SKRIPT" ] ||
           { case "$(basename "$ERSTES")" in perl|bash|sh|dash) true ;; *) false ;; esac &&
             printf '%s\n' "$ARGS" | grep -qxF "$SKRIPT"; }; then
            return 0
        fi
    done
    return 1
}

# Carry out specific functions when asked to by the system
case "$1" in
  'start')
    echo "Starting Wolf ISM8i server"
    ${BINPATH}/wolf_watchdog.sh &
    # RETVAL=$? unmittelbar nach "&" misst den Hintergrundstart, nicht
    # den Lauf: "false &" ergibt 0, "/gibtesnicht &" ebenso. Der
    # stop-Zweig wurde deshalb schon in 3.0.8 auf Wirkungsmessung
    # umgebaut - start und restart blieben stehen. Jetzt nicht mehr.
    sleep 1
    if wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
        RETVAL=0
    else
        echo "WARNUNG: der Watchdog laeuft nach dem Start nicht."
        RETVAL=1
    fi
    ;;
  'stop')
    echo "Stopping Wolf ISM8i server"
    wolf_beenden "${BINPATH}/wolf_watchdog.sh"
    wolf_beenden "${BINPATH}/wolf_ism8i.pl"
    # RETVAL=$? nach wolf_beenden trug keine Aussage - die Funktion endet
    # immer erfolgreich, stop meldete also IMMER Erfolg. Gemessen wird
    # jetzt die WIRKUNG.
    sleep 1
    if wolf_laeuft "${BINPATH}/wolf_watchdog.sh" || wolf_laeuft "${BINPATH}/wolf_ism8i.pl"; then
        echo "WARNUNG: es laeuft noch ein Prozess."
        RETVAL=1
    else
        RETVAL=0
    fi
    ;;
  'restart')
    echo "Restarting Wolf ISM8i server"
    wolf_beenden "${BINPATH}/wolf_watchdog.sh"
    wolf_beenden "${BINPATH}/wolf_ism8i.pl"
    # Hier stand ein RETVAL=$? nach wolf_beenden - eine tote
    # Zuweisung, drei Zeilen spaeter ueberschrieben.
    sleep 1
    ${BINPATH}/wolf_watchdog.sh &
    sleep 1
    if wolf_laeuft "${BINPATH}/wolf_watchdog.sh"; then
        RETVAL=0
    else
        echo "WARNUNG: der Watchdog laeuft nach dem Neustart nicht."
        RETVAL=1
    fi
    ;;
  'status')
    # status hat bis 3.0.7 nur den Watchdog angesehen. Der kann laufen,
    # waehrend das Auswertungsmodul in seiner Neustartschleife haengt -
    # die Meldung "is running" war dann eine halbe Wahrheit.
    W=0; M=0
    wolf_laeuft "${BINPATH}/wolf_watchdog.sh" && W=1
    wolf_laeuft "${BINPATH}/wolf_ism8i.pl"    && M=1
    if [ "$W" -eq 1 ] && [ "$M" -eq 1 ]; then
        echo "Wolf ISM8i server is running (Watchdog und Auswertungsmodul)"
        RETVAL=0
    elif [ "$W" -eq 1 ]; then
        echo "Wolf ISM8i server: Watchdog laeuft, Auswertungsmodul NICHT"
        RETVAL=1
    elif [ "$M" -eq 1 ]; then
        echo "Wolf ISM8i server: Auswertungsmodul laeuft ohne Watchdog"
        RETVAL=1
    else
        echo "Wolf ISM8i server is not running"
        RETVAL=3
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/wolfserver {start|stop|restart|status}"
    exit 1
    ;;
esac

exit $RETVAL
