#!/bin/bash
# Wolf ISM8 - Waechter ueber den Waechter (V10)
#
# WARUM ES DAS GIBT
#
# Der Watchdog wird beim Hochfahren aus daemon/daemon gestartet und sonst nur
# von der Oberflaeche. Und er beendet sich selbst: stuerzt das Auswertungsmodul
# zwanzigmal in Folge ab, schreibt er LOGCRIT und geht mit exit 1
# (bin/wolf_watchdog.sh). Danach lief bis zum naechsten Neustart des Rechners
# nichts wieder an - und in Loxone sah alles normal aus, weil virtuelle
# Eingaenge ihren letzten Wert behalten.
#
# DREI DINGE, DIE DIESES SKRIPT EINHAELT
#
#  1. Die Pfade kommen aus den Platzhaltern des Installers, nicht aus einer Rechnung mit ".." und
#     nicht aus einem fest verdrahteten Systempfad. Der Installer ersetzt
#     die Platzhalter beim Einbau.
#  2. Es SCHWEIGT im Normalfall. Ein Cron, der in den Systemlogger schreibt,
#     erzeugt sonst 288 Zeilen am Tag.
#  3. Es tut NICHTS, wenn das Plugin ausgeschaltet ist. Ein Waechter, der
#     gegen den Willen des Anwenders arbeitet, ist schlimmer als keiner.
#
# Diese Datei ist eine DATEI, kein Verzeichnis. LoxBerry fuehrt in
# system/cron/cron.05min/ nur Dateien aus.

BINPATH="REPLACELBPBINDIR"
CONFIG="REPLACELBPCONFIGDIR/wolf_ism8i.conf"

# --- Laeuft gerade eine Aktualisierung dieses Plugins? ---
#
# preupgrade.sh legt die Marke als Erstes neben den Datenordner des Plugins,
# postupgrade.sh entfernt sie nach dem Dienststart. Der Ordnerpfad kommt aus
# dem Platzhalter, den der Installer beim Einbau ersetzt.
#
# Diese Frage steht ABSICHTLICH vor der nach dem Schalter: in der Luecke ist
# die Konfiguration weggeraeumt, und auch der SG-Ready-Lauf weiter unten soll
# dann nicht an die Heizung schreiben.
#
# Nur eine Marke, die hoechstens eine Stunde alt ist, zaehlt. Aelter, aus der
# Zukunft oder unlesbar: eine abgebrochene Installation hat sie liegen
# lassen, und das Plugin darf nicht fuer immer stillstehen.
MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$MARKE" ]; then
    SEIT=$(cat "$MARKE" 2>/dev/null)
    case "$SEIT" in
        ''|*[!0-9]*) SEIT="" ;;
    esac
    if [ -n "$SEIT" ]; then
        # Die Uhr wird gemessen, nicht angenommen: liefert "date" nichts -
        # unter Last kann ein fork scheitern -, dann rechnet die Schale mit
        # einer leeren Zeichenkette, das Alter wird negativ, die Bedingung
        # faellt durch, und der Waechter startet MITTEN in der
        # Aktualisierung. Ein Schutz faellt geschlossen aus (Regeln/01):
        # ohne Uhr gilt die Marke. Dieselbe Stelle steht in bin/wolf_server.
        JETZT=$(date +%s 2>/dev/null)
        case "$JETZT" in
            ''|*[!0-9]*) exit 0 ;;
        esac
        ALTER=$(( JETZT - SEIT ))
        if [ "$ALTER" -ge 0 ] && [ "$ALTER" -lt 3600 ]; then
            exit 0
        fi
    fi
fi

# --- 3. Ausgeschaltet? Dann ist hier nichts zu tun. ---
enabled=$(awk '/^enable[ \t]/{print $2}' "$CONFIG" 2>/dev/null)
enabled=${enabled:-0}
[ "$enabled" = "1" ] || exit 0

# --- Laeuft der Waechter? ---
# Argumentweise ueber /proc, wie ueberall in diesem Plugin: "pkill -f" traefe
# auch einen Editor mit offener Datei, und "ps -C" vergleicht den comm-Namen,
# der bei einem Skript mit Shebang "bash" lautet.
wolf_laeuft() {
    SKRIPT="$1"
    for D in /proc/[0-9]*; do
        [ -r "$D/cmdline" ] || continue
        ARGS=$(tr '\0' '\n' < "$D/cmdline" 2>/dev/null)
        ERSTES=$(printf '%s\n' "$ARGS" | head -1)
        if [ "$ERSTES" = "$SKRIPT" ] ||
           { case "$(basename "$ERSTES")" in perl|bash|sh|dash) true ;; *) false ;; esac &&
             printf '%s\n' "$ARGS" | grep -qxF "$SKRIPT"; }; then
            return 0
        fi
    done
    return 1
}

# --- SG-Ready und Paragraph 14a (V24, neu in 3.1.0) ---
#
# Der Lauf beendet sich selbst sofort, wenn sg_ein auf 0 steht - das ist
# der Werkszustand. Er schreibt dann weder ins Protokoll noch an die
# Heizung. Fuenf Minuten sind fuer einen Plan, der stuendlich wechselt,
# reichlich genau; ein Ladefenster faengt hoechstens vier Minuten zu
# spaet an.
if [ -x /usr/bin/php ] || command -v php >/dev/null 2>&1; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su loxberry -s /bin/sh -c "php '$BINPATH/wolf_sg.php' --einmal" >/dev/null 2>&1
    else
        php "$BINPATH/wolf_sg.php" --einmal >/dev/null 2>&1
    fi
fi


wolf_laeuft "$BINPATH/wolf_watchdog.sh" && exit 0

# --- Er laeuft nicht. Nachstarten und EINMAL sagen, warum. ---
echo "Wolf ISM8: der Watchdog lief nicht - wird nachgestartet."
# Als loxberry nachstarten, nicht als root. LoxBerry fuehrt die
# Plugin-Crons je nach Ablage als root aus; der Dienst legte danach
# Protokoll- und Zustandsdatei mit root-Eigentum an, und die
# Oberflaeche konnte sie nicht mehr ueberschreiben. daemon/daemon
# steigt aus demselben Grund ab.
if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
    su loxberry -s /bin/sh -c "'$BINPATH/wolf_server' start" > /dev/null 2>&1
else
    "$BINPATH/wolf_server" start > /dev/null 2>&1
fi

exit 0
